#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<long long>nums(n);
	    for(int i=0;i<n;i++){
	        cin>>nums[i];
	    }
	    int intial=0;
	    for(int i=1;i<n;i++){
	        if(nums[i]==nums[i-1]) intial++;
	    }
	    long long maxi_left=-1e9;
	    long long ans=-1e9;
	    for(int i=0;i<n;i++){
	        long long left=0;
	        if(i>0){
	            if(nums[i-1]==nums[i]+1) left=1;
	            else if(nums[i-1]==nums[i]) left=-1;
	        }
	        maxi_left=max(maxi_left,left);
	        long long right=0;
	        if(i<n-1){
	            if(nums[i]+1==nums[i+1]) right=1;
	            else if(nums[i]==nums[i+1]) right=-1;
	        }
	        ans=max(ans,maxi_left+right);
	}
	cout<<ans<<endl;
}
}
