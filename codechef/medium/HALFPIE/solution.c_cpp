#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int>arr(n);
	    for(int &x:arr){
	        cin>>x;
	    }
	    int sum=0;
	    int mini=INT_MAX;
	    for(int i=1;i<n;i++){
	        sum+=arr[i]+arr[i-1];
	        mini=min(sum,mini);
	        sum=0;
	    }
	    //cout<<mini<<endl;
	    int total=std::accumulate(arr.begin(), arr.end(), 0);
	    cout<<total-(mini)/2<<endl;
	}

}
