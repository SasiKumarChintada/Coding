#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,m;
	    cin>>n>>m;
	    int minRow=n,maxRow=-1;
	    int minCol=m,maxCol=-1;
	    for(int i=0;i<n;i++){
	        string s;
	        cin>>s;
	        for(int j=0;j<m;j++){
	            if(s[j]=='1'){
	                minRow=min(minRow,i);
	                maxRow=max(maxRow,i);
	                minCol=min(minCol,j);
	                maxCol=max(maxCol,j);
	            }
	        }
	    }
	    cout<<( maxRow-minRow+1 )* (maxCol-minCol+1)<<endl;
	}
}
