#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int t;
	    cin>>t;
	    long long n,m;
	    cin>>n>>m;
	    int k;
	    cin>>k;
	    vector<pair<int,int>>a(k);
	    for(int i=0;i<k;i++){
	        cin>>a[i].first>>a[i].second;
	    }
	    sort(a.begin(),a.end());
	    vector<int>d;
	    for(int i=0;i<k;i++){
	        int y=a[i].second;
	        auto it=std::upper_bound(d.begin(), d.end(), y);
	        if(it==d.end()){
	            d.push_back(y);
	        }
	        else{
	            *it=y;
	        }
	    }
	    long long ans=(n+m-1)+d.size();
	    cout<<ans<<endl;
	}

}
