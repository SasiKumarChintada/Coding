#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    string s;
	    cin>>s;
	    int alaram=0;
	    int i=n-1;
	    while(i>=0){
	        while(i>=0 && s[i]=='0'){
	            i--;
	        }
	        if(i<0) break;
	        alaram++;
	        i=i-k-1;
	    }
	    cout<<alaram<<endl;
	}

}
