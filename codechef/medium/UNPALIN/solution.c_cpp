#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int>arr(n);
	    for(int &x:arr){
	        cin>>x;
	    }
	    int l=0,r=n-1;
	    while(l<r){
	        if(arr[l]!=arr[r]){
	            break;
	        }
	        l++;
	        r--;
	    }
	    if(l>=r){
	        cout<<"NO\n";
	    }
	    else{
	        cout<<"YES ";
	        for(int x=1;x<=n;x++){
	            if(x!=arr[l] && x!=arr[r]){
	                cout<<x<<endl;
	                break;
	            }
	        }
	    }
	}

}
