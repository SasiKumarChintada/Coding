#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    string s;
	    cin>>s;
	    int a=0,b=0;
	    int ans=0;
	    for(int i=0;i<n;i++){
	        if(s[i]=='A'){
	            a++;
	            b=0;
	            if(a==3){
	                ans++;
	                a=0;
	            }
	        }
	        else if(s[i]=='B'){
	            b++;
	            a=0;
	            if(b==3){
	                ans++;
	                b=0;
	            }
	        }
	    }
	    cout<<ans<<endl;
	}

}
