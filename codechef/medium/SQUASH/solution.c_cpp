#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n,k;
	    cin>>n>>k;
	    string s;
	    cin>>s;
	    int a=0,b=0;
	    int ans=0;
	    int need=0;
	    for(int i=0;i<n;i++){
	        if(s[i]=='A'){
	            if(a==0){
	                a++;
	                need++;
	                b=0;
	            }
	        }
	        else{
	            if(b==0){
	                b++;
	                need++;
	                a=0;
	            }
	        }
	    }
	    cout<<need<<" ";
	    if(need<=k) cout<<"YES\n";
	    else cout<<"NO\n";
	}

}
