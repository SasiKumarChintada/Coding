#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    long long x,y,d;
	    cin>>x>>y>>d;
	    long long i=1,j=1;
	    while(true){
	        long long t1=i*x;
	        long long t2=y*j;
	        if(abs(t1-t2)<=d){
	            cout<<max(t1,t2)<<endl;
	            break;
	        }
	        if(t1<t2){
	            i++;
	        }
	        else j++;
	    }
	}

}
