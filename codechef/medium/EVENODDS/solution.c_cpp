#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int>arr(n);
	    for(int &x:arr) cin>>x;
	    int total_odds=0;
	    int first=-1;
	    int last=-1;
	    int l=0;
	    int max_len=INT_MIN;
	    for(int i=0;i<n;i++){
	        if(arr[i]%2!=0){
	            total_odds++;
	            if(first==-1){
	                first=i;
	            }
	            last=i;
	        }
	    }
	    if(total_odds%2==0){
	        cout<<n<<"\n";
	    }
	    else{
	        cout<<max(n-1-first,last)<<endl;
	    }
	}

}
